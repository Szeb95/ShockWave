<Project>
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <!-- Historical graphics checks compile their own renderer, never the app. -->
    <Compile Include="$(MSBuildThisFileDirectory)../../work/ShaderPanelTest/GpuRenderer.cs" Link="LegacyRenderer/GpuRenderer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PanelFrameRenderer.cs" Link="LegacyRenderer/PanelFrameRenderer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PanelRenderWorker.cs" Link="LegacyRenderer/PanelRenderWorker.cs" />
    <Content Include="$(MSBuildThisFileDirectory)Shaders/**/*" Link="ToyControl/Shaders/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>
</Project>
