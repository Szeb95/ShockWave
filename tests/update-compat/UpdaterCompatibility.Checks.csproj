<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.8.1</Version>
    <LegacyVersion Condition="'$(LegacyVersion)' == ''">0.7.11</LegacyVersion>
    <OutputPath>bin/$(LegacyVersion)/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/$(LegacyVersion)/$(Configuration)/</IntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="Legacy/$(LegacyVersion)/*.cs" />
    <Content Include="Legacy/$(LegacyVersion)/*.cs" Link="legacy-source/%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <Content Include="Legacy/$(LegacyVersion)/provenance.json" Link="legacy-provenance.json" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <Target Name="ValidateLegacyVersion" BeforeTargets="BeforeBuild">
    <Error Condition="'$(LegacyVersion)' != '0.7.0' and '$(LegacyVersion)' != '0.7.11' and '$(LegacyVersion)' != '0.8.0'" Text="Unknown legacy updater version." />
  </Target>
</Project>
